# Use `brew bundle --file=$HOME/.brewfile` to install the packages listed below

tap "benjiwolff/neovim-nightly", "git@github.com:benjiwolff/homebrew-neovim-nightly.git"
tap "heroku/brew"

brew "1password-cli"
brew "bat"
brew "direnv"
brew "fd"
brew "fish"
brew "fisher"
brew "fzf"
brew "gh"
brew "git"
brew "glab"
brew "gpg2"
brew "heroku"
brew "jq"
brew "mas"
brew "mise"
brew "mosh"
brew "opencode"
brew "ripgrep"
brew "sst/tap/opencode"
brew "tldr"
brew "tree"
brew "universal-ctags"

cask "1password"
cask "anki"
cask "brainfm"
cask "bruno"
cask "cleanshot"
cask "dash"
cask "discord"
cask "figma"
cask "firefox@developer-edition"
cask "font-symbols-only-nerd-font"
cask "neovim-nightly"
cask "ngrok"
cask "slack"
cask "tuple"
cask "wezterm"

mas "1Password for Safari", id: 1569813296
mas "Agenda", id: 1287445660
mas "Things 3", id: 904280696
